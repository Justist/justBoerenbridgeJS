{
  "name": "justboerenbridgejs",
  "version": "1.0.0",
  "private": true,
  "description": "Boerenbridge score app with Playwright regression tests",
  "scripts": {
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "http-server": "^14.1.1"
  }
}

